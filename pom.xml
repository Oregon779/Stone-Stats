<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stonestats</groupId>
    <artifactId>stonestats</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Stone Stats</name>
    <description>Fast, fully configurable player-statistics GUI for Paper servers - kills, deaths, playtime,
        blocks broken/placed and more, opened with /stats.
    </description>

    <properties>
        <!-- Portability: bumped from Java 21 to Java 25 for Paper API 26.2 -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API is provided by the server at runtime (includes Adventure and Gson) -->
        <!-- Portability: pinned to the fixed stable build 26.2.build.124-stable
             instead of a version range, since open ranges (e.g. [26.2.build,))
             cannot be resolved without reaching repo.papermc.io -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.124-stable</version>
            <scope>provided</scope>
        </dependency>
        <!-- Optional integration (softdepend) - only compiled against, never
             bundled. Every call into this API is guarded by a runtime
             plugin-presence check (see PlaceholderApiHook), so the server
             works completely normally when PlaceholderAPI isn't installed. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>StoneStats-${project.version}</finalName>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Portability: bumped from 21 to 25 for Paper API 26.2 -->
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </build>
</project>
